# PostgreSQL bağlantısı
DATABASE_URL=postgres://pet:pet@localhost:5432/petdb
# Ürün görsellerinin saklanacağı dizin (Docker'da volume)
UPLOAD_DIR=./uploads
# Platformun dış adresi (bağlantılar ve çerezler için)
APP_URL=http://localhost:3000
# Platform yönetim ekranına (/yonetim) erişebilecek e-postalar, virgülle ayrılmış
ADMIN_EMAILS=
# Kendi alan adı özelliği
# sync-pet-domains.sh'in alan adı listesini okuması için (en az 16 karakter)
PET_INTERNAL_TOKEN=
# Müşterilerin CNAME hedefi (varsayılan: APP_URL'deki host)
CUSTOM_DOMAIN_TARGET=
# İsteğe bağlı Cloudflare for SaaS otomasyonu
CF_API_TOKEN=
CF_ZONE_ID=
# Platformun kendi sayılacak ek host adları, virgülle ayrılmış
PLATFORM_HOSTS=
